\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {TurboPark.} Required buffer $d^*(a, f)$ at $\tau = 2.0\%$ AEP under TurboPark ($A = 0.04$, TI = 0.06; $K = 2000$, FunWake schedule). Note the threshold is $10\times $ higher than Fig.~\ref {fig:buffer-table-contour}, because TurboPark's slower wake recovery raises realistic-scenario regret by one to two orders of magnitude. The threshold is unmet within the swept range ($d^* > 40D$) over most of the shape space, including the region containing all five fitted real sites: interpolated requirements run from $\sim $42$D$ (Princess Amalia, most bidirectional) to $\sim $60$D$ (Lillgrund, most unidirectional), i.e.\ 10--14\,km.}}{15}{figure.caption.10}\protected@file@percent }
\newlabel{fig:buffer-table-tp-contour}{{8}{15}{\textbf {TurboPark.} Required buffer $d^*(a, f)$ at $\tau = 2.0\%$ AEP under TurboPark ($A = 0.04$, TI = 0.06; $K = 2000$, FunWake schedule). Note the threshold is $10\times $ higher than Fig.~\ref {fig:buffer-table-contour}, because TurboPark's slower wake recovery raises realistic-scenario regret by one to two orders of magnitude. The threshold is unmet within the swept range ($d^* > 40D$) over most of the shape space, including the region containing all five fitted real sites: interpolated requirements run from $\sim $42$D$ (Princess Amalia, most bidirectional) to $\sim $60$D$ (Lillgrund, most unidirectional), i.e.\ 10--14\,km}{figure.caption.10}{}}
