\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Required buffer distance $d^*$ (in rotor diameters) such that peak design regret $\leq 0.2\%$ AEP, as a function of elliptical-rose parameters $(a, f)$. Bastankhah ($k = 0.04$), $K = 2000$, FunWake schedule; entries marked $>40$ denote regret that does not cross the threshold within the swept buffer range. Under TurboPark, even a $10\times $ higher threshold requires buffers beyond $40D$ over most of the shape space (Table~\ref {tab:buffer-table-tp}).}}{13}{table.caption.8}\protected@file@percent }
\newlabel{tab:buffer-table}{{2}{13}{Required buffer distance $d^*$ (in rotor diameters) such that peak design regret $\leq 0.2\%$ AEP, as a function of elliptical-rose parameters $(a, f)$. Bastankhah ($k = 0.04$), $K = 2000$, FunWake schedule; entries marked $>40$ denote regret that does not cross the threshold within the swept buffer range. Under TurboPark, even a $10\times $ higher threshold requires buffers beyond $40D$ over most of the shape space (Table~\ref {tab:buffer-table-tp})}{table.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Bastankhah.} Required buffer $d^*(a, f)$ at $\tau = 0.2\%$ AEP ($K = 2000$, FunWake schedule). Markers: fitted real-site placements (Horns Rev 1, Lillgrund, Borssele, Princess Amalia, DEI). The five fitted real-site placements require $d^* \approx 8$--$9D$ ($\sim $2\,km) at this threshold.}}{14}{figure.caption.9}\protected@file@percent }
\newlabel{fig:buffer-table-contour}{{7}{14}{\textbf {Bastankhah.} Required buffer $d^*(a, f)$ at $\tau = 0.2\%$ AEP ($K = 2000$, FunWake schedule). Markers: fitted real-site placements (Horns Rev 1, Lillgrund, Borssele, Princess Amalia, DEI). The five fitted real-site placements require $d^* \approx 8$--$9D$ ($\sim $2\,km) at this threshold}{figure.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {TurboPark} buffer table $d^*(a, f; \tau = 2\%)$ in rotor diameters. $K = 2000$, FunWake schedule, TurboPark $A = 0.04$, TI = 0.06. $>40$ denotes regret that does not cross the threshold within the swept buffer range.}}{14}{table.caption.11}\protected@file@percent }
\newlabel{tab:buffer-table-tp}{{3}{14}{\textbf {TurboPark} buffer table $d^*(a, f; \tau = 2\%)$ in rotor diameters. $K = 2000$, FunWake schedule, TurboPark $A = 0.04$, TI = 0.06. $>40$ denotes regret that does not cross the threshold within the swept buffer range}{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {TurboPark.} Required buffer $d^*(a, f)$ at $\tau = 2.0\%$ AEP under TurboPark ($A = 0.04$, TI = 0.06; $K = 2000$, FunWake schedule). Note the threshold is $10\times $ higher than Fig.~\ref {fig:buffer-table-contour}, because TurboPark's slower wake recovery raises realistic-scenario regret by one to two orders of magnitude. Hatching marks cells where the threshold is never reached within the swept range, so $d^*$ is censored at $>40D$ rather than measured. That censored region covers most of the shape space, including every one of the five fitted real sites; we therefore report their requirement as $>40D$ ($>9.6$\,km) and deliberately do not interpolate a finite value through censored cells.}}{15}{figure.caption.10}\protected@file@percent }
\newlabel{fig:buffer-table-tp-contour}{{8}{15}{\textbf {TurboPark.} Required buffer $d^*(a, f)$ at $\tau = 2.0\%$ AEP under TurboPark ($A = 0.04$, TI = 0.06; $K = 2000$, FunWake schedule). Note the threshold is $10\times $ higher than Fig.~\ref {fig:buffer-table-contour}, because TurboPark's slower wake recovery raises realistic-scenario regret by one to two orders of magnitude. Hatching marks cells where the threshold is never reached within the swept range, so $d^*$ is censored at $>40D$ rather than measured. That censored region covers most of the shape space, including every one of the five fitted real sites; we therefore report their requirement as $>40D$ ($>9.6$\,km) and deliberately do not interpolate a finite value through censored cells}{figure.caption.10}{}}
